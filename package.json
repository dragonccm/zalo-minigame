{
  "name": "gamehub",
  "version": "0.2.0",
  "private": true,
  "description": "Cổng game HTML5: tài khoản, hồ sơ, bảng xếp hạng, thành tựu, nhiệm vụ thưởng, multiplayer realtime, upload game và duyệt bởi admin",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "db:up": "docker compose up -d db",
    "db:reset": "node tools/db-reset.js",
    "backup": "node tools/backup.js",
    "validate": "node tools/validate-game.js",
    "test": "node tools/e2e-test.js",
    "test:mp": "node tools/mp-test.js",
    "test:ui": "node tools/ui-test.js ./shots",
    "icons": "node tools/build-icons.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "lucide-static": "^1.62.0"
  }
}
