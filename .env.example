# Sao chép thành .env rồi sửa. (server tự đọc file .env nếu có)

# PostgreSQL. Bỏ trống để dùng PGlite (Postgres nhúng, lưu ở data/pgdata) khi phát triển.
DATABASE_URL=postgres://gamehub:gamehub_dev_pw@127.0.0.1:55440/gamehub
# Số kết nối tối đa trong pool
DB_POOL_MAX=10

PORT=8080
ADMIN_USER=admin
ADMIN_PASS=doi-mat-khau-nay

# Bí mật ký token (phiên xem thử, vé realtime, token nhiệm vụ). Đặt cố định để token còn hiệu lực sau khi khởi động lại.
APP_SECRET=hay-thay-bang-chuoi-ngau-nhien-dai

COOKIE_SECURE=0
TRUST_PROXY=0
UPLOADS_PER_HOUR=10

# Zalo Mini App: nguồn được gọi API + nhúng game (cách nhau bởi dấu phẩy). Mini App chạy trên https://h5.zdn.vn
# (khi dev bằng "zmp start" thêm http://localhost:3000)
CORS_ORIGINS=
# Khoá bí mật của Zalo App (developers.zalo.me) — để ký appsecret_proof khi hỏi Graph API
ZALO_APP_SECRET=
# Zalo chặn Graph API với IP ngoài Việt Nam (-501). Khi máy chủ ở nước ngoài, chạy zalo-proxy/ trên máy ở Việt Nam rồi đặt:
# ZALO_GRAPH_URL=https://<proxy-o-viet-nam>/me
# ZALO_PROXY_KEY=<giống PROXY_KEY của proxy>
